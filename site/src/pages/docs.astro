              <tr><td><code>direction</code></td><td><code>FlowchartDirection</code></td><td>Flow direction (TB, LR, etc.)</td></tr>
              <tr><td><code>nodes</code></td><td><code>FlowchartNode[]</code></td><td>All parsed nodes</td></tr>
